{
  "name": "quizmaster-pro",
  "version": "1.0.0",
  "description": "Secure full-stack quiz platform with user and administrator experiences.",
  "private": true,
  "main": "server/server.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "seed:questions": "node server/database/seedQuestions.js",
    "reset:questions": "node server/database/resetQuestions.js",
    "test:email": "node scripts/testEmailConnection.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:integration": "jest --runInBand tests/*.integration.test.js",
    "test:e2e": "playwright test",
    "check:syntax": "find server client/js scripts tests e2e -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "check": "npm run check:syntax && npm run lint && npm run format:check && npm test",
    "audit:prod": "npm audit --omit=dev",
    "lint": "eslint server client/js scripts tests e2e *.js",
    "format:check": "prettier --check package.json server client tests e2e docs *.md",
    "format": "prettier --write package.json server client tests e2e docs *.md"
  },
  "keywords": [
    "quiz",
    "education",
    "express",
    "mongodb"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ashish-Vision/QuizMaster-Pro.git"
  },
  "homepage": "https://github.com/Ashish-Vision/QuizMaster-Pro#readme",
  "bugs": {
    "url": "https://github.com/Ashish-Vision/QuizMaster-Pro/issues"
  },
  "author": "Ashish-Vision",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
