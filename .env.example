# Core local application settings
NODE_ENV=development
PORT=5000

# Required. Quiz completion uses transactions, so MongoDB must run as a replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/quizmaster_pro?replicaSet=rs0

# Required. Replace with a random value of at least 32 characters.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d
JWT_ISSUER=quizmaster-pro
JWT_AUDIENCE=quizmaster-pro-users

# Required origins. These defaults are safe for local development.
APP_ORIGIN=http://localhost:5000
CLIENT_ORIGIN=http://localhost:5000

# Optional email delivery. Verification/recovery email requires all SMTP fields.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=local-smtp-user@example.com
SMTP_PASSWORD=replace_with_an_app_password
EMAIL_FROM_NAME=QuizMaster Pro
EMAIL_FROM_ADDRESS=no-reply@example.com

# Optional and local-development only. Keep false unless testing reset links locally.
EXPOSE_DEVELOPMENT_RESET_URL=false

# Optional avatar storage. Avatar upload requires all three Cloudinary fields.
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret

# Optional test override. Omit to use /usr/bin/mongod when available or allow
# mongodb-memory-server to manage its isolated test binary.
# MONGOMS_SYSTEM_BINARY=/absolute/path/to/mongod
