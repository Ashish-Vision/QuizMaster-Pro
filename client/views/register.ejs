<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content="Create your QuizMaster Pro account." />

    <title>Create Account | QuizMaster Pro</title>

    <link rel="stylesheet" href="/css/variables.css" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/animations.css" />
    <link rel="stylesheet" href="/css/auth.css" />
    <link rel="stylesheet" href="/css/responsive.css" />
  </head>

  <body>
    <%- include("partials/navbar") %>

    <main class="auth-page">
      <div class="auth-glow auth-glow-one"></div>
      <div class="auth-glow auth-glow-two"></div>

      <section class="auth-container">
        <!-- ================= INTRODUCTION ================= -->

        <div class="auth-introduction">
          <p class="auth-label">Join QuizMaster Pro</p>

          <h1>
            Learn smarter and
            <span>compete globally</span>
          </h1>

          <p class="auth-description">
            Create an account to unlock personalized quizzes, achievements,
            statistics and competitive challenges.
          </p>

          <div class="auth-statistics">
            <div>
              <strong>10K+</strong>
              <span>Questions</span>
            </div>

            <div>
              <strong>25+</strong>
              <span>Categories</span>
            </div>

            <div>
              <strong>5K+</strong>
              <span>Players</span>
            </div>
          </div>
        </div>

        <!-- ================= REGISTER CARD ================= -->

        <div class="auth-card">
          <div class="auth-card-header">
            <h2>Create account</h2>

            <p>Start your learning journey today.</p>
          </div>

          <div
            id="registerMessage"
            class="form-message"
            role="alert"
            aria-live="polite"
          ></div>

          <form id="registerForm" class="auth-form" novalidate>
            <!-- ================= NAME ================= -->

            <div class="form-row">
              <div class="form-group">
                <label for="firstName"> First name </label>

                <input
                  id="firstName"
                  name="firstName"
                  type="text"
                  placeholder="Ashish"
                  minlength="2"
                  maxlength="50"
                  autocomplete="given-name"
                  required
                />

                <small
                  id="firstNameError"
                  class="field-error"
                  aria-live="polite"
                ></small>
              </div>

              <div class="form-group">
                <label for="lastName"> Last name </label>

                <input
                  id="lastName"
                  name="lastName"
                  type="text"
                  placeholder="Mamillapalli"
                  minlength="2"
                  maxlength="50"
                  autocomplete="family-name"
                  required
                />

                <small
                  id="lastNameError"
                  class="field-error"
                  aria-live="polite"
                ></small>
              </div>
            </div>

            <!-- ================= EMAIL ================= -->

            <div class="form-group">
              <label for="registerEmail"> Email address </label>

              <input
                id="registerEmail"
                name="email"
                type="email"
                placeholder="you@example.com"
                autocomplete="email"
                required
              />

              <small
                id="registerEmailError"
                class="field-error"
                aria-live="polite"
              ></small>
            </div>

            <!-- ================= PASSWORD ================= -->

            <div class="form-group">
              <label for="registerPassword"> Password </label>

              <div class="password-wrapper">
                <input
                  id="registerPassword"
                  name="password"
                  type="password"
                  placeholder="Minimum 8 characters"
                  minlength="8"
                  maxlength="128"
                  autocomplete="new-password"
                  required
                />

                <button
                  type="button"
                  class="password-toggle"
                  data-password-target="registerPassword"
                  aria-label="Show password"
                >
                  Show
                </button>
              </div>

              <div class="password-strength" aria-hidden="true">
                <span id="strengthBar" class="strength-bar"></span>
              </div>

              <small id="strengthText" class="password-strength-text">
                Password strength
              </small>

              <small
                id="registerPasswordError"
                class="field-error"
                aria-live="polite"
              ></small>
            </div>

            <!-- ================= CONFIRM PASSWORD ================= -->

            <div class="form-group">
              <label for="confirmPassword"> Confirm password </label>

              <div class="password-wrapper">
                <input
                  id="confirmPassword"
                  name="confirmPassword"
                  type="password"
                  placeholder="Re-enter your password"
                  minlength="8"
                  maxlength="128"
                  autocomplete="new-password"
                  required
                />

                <button
                  type="button"
                  class="password-toggle"
                  data-password-target="confirmPassword"
                  aria-label="Show password"
                >
                  Show
                </button>
              </div>

              <small
                id="confirmPasswordError"
                class="field-error"
                aria-live="polite"
              ></small>
            </div>

            <!-- ================= TERMS ================= -->

            <label class="terms-option">
              <input
                id="acceptTerms"
                name="acceptTerms"
                type="checkbox"
                required
              />

              <span>
                I agree to the
                <a href="/terms">Terms of Service</a>
                and
                <a href="/privacy">Privacy Policy</a>.
              </span>
            </label>

            <small
              id="acceptTermsError"
              class="field-error"
              aria-live="polite"
            ></small>

            <!-- ================= SUBMIT ================= -->

            <button
              id="registerButton"
              type="submit"
              class="primary-button auth-submit-button"
            >
              <span class="button-text"> Create Account </span>

              <span class="button-loader" aria-hidden="true"></span>
            </button>
          </form>

          <!-- ================= SOCIAL REGISTER ================= -->

          <div class="auth-divider">
            <span>or register with</span>
          </div>

          <button
            id="googleRegisterButton"
            type="button"
            class="social-auth-button"
          >
            <span class="google-icon">G</span>
            Continue with Google
          </button>

          <p class="auth-switch">
            Already have an account?

            <a href="/login"> Sign in </a>
          </p>
        </div>
      </section>
    </main>

    <%- include("partials/footer") %>

    <script src="/js/ui.js"></script>

    <!--
      register.js handles:
      form validation,
      password visibility,
      password strength,
      registration API request,
      email-verification redirect.
    -->
    <script src="/js/register.js" defer></script>
  </body>
</html>
