<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      name="description"
      content="View your QuizMaster Pro quiz result and review your answers."
    />

    <title>Quiz Result | QuizMaster Pro</title>

    <link rel="stylesheet" href="/css/result.css" />
  </head>

  <body>
    <main class="result-page">
      <section class="result-card" id="resultCard">
        <div id="resultIcon" class="result-icon" aria-hidden="true">🏆</div>

        <p id="resultLabel" class="result-label">Quiz completed</p>

        <h1>Great work, <%= user?.firstName || "QuizMaster" %>!</h1>

        <p class="result-category" id="resultCategory">Loading result...</p>

        <div id="dailyChallengeReward" class="daily-challenge-reward hidden">
          <span aria-hidden="true">🔥</span>

          <div>
            <strong> Daily Challenge Completed </strong>

            <p id="dailyChallengeRewardText">Bonus XP earned</p>
          </div>
        </div>

        <div
          id="scoreCircle"
          class="score-circle"
          role="img"
          aria-label="Quiz score"
        >
          <span id="scoreValue"> 0 </span>

          <small id="scoreTotal"> / 0 </small>
        </div>

        <div class="result-grid">
          <article class="result-stat">
            <span> Accuracy </span>

            <strong id="accuracyValue"> 0% </strong>
          </article>

          <article class="result-stat">
            <span> Correct </span>

            <strong id="correctValue"> 0 </strong>
          </article>

          <article class="result-stat">
            <span> Wrong </span>

            <strong id="wrongValue"> 0 </strong>
          </article>

          <article class="result-stat">
            <span> Unanswered </span>

            <strong id="unansweredValue"> 0 </strong>
          </article>

          <article class="result-stat">
            <span> XP Earned </span>

            <strong id="xpValue"> +0 XP </strong>
          </article>

          <article class="result-stat">
            <span> Time Taken </span>

            <strong id="timeValue"> 00:00 </strong>
          </article>
        </div>

        <div class="result-actions">
          <a href="/dashboard" class="secondary-button"> Dashboard </a>

          <button
            type="button"
            class="secondary-button"
            id="reviewAnswersButton"
            aria-expanded="false"
          >
            Review Answers
          </button>

          <button type="button" class="primary-button" id="retryQuizButton">
            Retry Quiz
          </button>
        </div>
      </section>

      <section
        id="reviewSection"
        class="review-section hidden"
        aria-labelledby="reviewTitle"
      >
        <div class="review-section-header">
          <div>
            <p class="review-label">Answer Review</p>

            <h2 id="reviewTitle">Review Your Answers</h2>

            <p>
              Check the correct answers and explanations for every question.
            </p>
          </div>

          <button id="closeReviewButton" type="button" class="secondary-button">
            Hide Review
          </button>
        </div>

        <div id="reviewSummary" class="review-summary">
          <article>
            <span> Correct </span>

            <strong id="reviewCorrectCount"> 0 </strong>
          </article>

          <article>
            <span> Wrong </span>

            <strong id="reviewWrongCount"> 0 </strong>
          </article>

          <article>
            <span> Unanswered </span>

            <strong id="reviewUnansweredCount"> 0 </strong>
          </article>
        </div>

        <div id="reviewList" class="review-list" aria-live="polite">
          <div class="review-loading">Loading answer review...</div>
        </div>
      </section>

      <section class="result-error hidden" id="resultError">
        <div class="error-icon">!</div>

        <h1>Result unavailable</h1>

        <p id="resultErrorMessage">
          We could not find your recent quiz result.
        </p>

        <a href="/dashboard" class="primary-button"> Return to Dashboard </a>
      </section>
    </main>
    <div
      id="levelUpOverlay"
      class="levelup-overlay hidden"
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
      aria-labelledby="levelUpTitle"
    >
      <div class="levelup-card">
        <div class="levelup-icon">🎉</div>

        <h2 id="levelUpTitle">LEVEL UP!</h2>

        <p class="level-transition">
          <span id="oldLevel"></span>
          →
          <span id="newLevel"></span>
        </p>

        <div class="rank-transition">
          <span id="oldRank"></span>
          →
          <span id="newRank"></span>
        </div>

        <button id="continueButton" type="button" class="primary-button">
          Continue
        </button>
      </div>
    </div>

    <script src="/js/result.js" defer></script>
    <script src="/js/result-celebrations.js" defer></script>
    <script src="/js/achievement-celebrations.js" defer></script>
    <script src="/js/daily-challenge-celebration.js" defer></script>
  </body>
</html>
