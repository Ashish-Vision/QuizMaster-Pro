<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      name="description"
      content="Review QuizMaster Pro administrator activity logs."
    />

    <title>Activity Logs | QuizMaster Pro</title>

    <link rel="stylesheet" href="/css/admin/activity-logs.css" />

    <script src="/js/dialogs.js" defer></script>
    <script src="/js/admin/activity-logs.js" defer></script>
  </head>

  <body>
    <div class="admin-layout">
      <aside class="admin-sidebar">
        <a href="/admin" class="admin-brand">
          <span class="brand-icon">Q</span>

          <div>
            <strong>QuizMaster Pro</strong>
            <small>Administration</small>
          </div>
        </a>

        <nav class="admin-navigation">
          <a href="/admin">
            <span>📊</span>
            Dashboard
          </a>

          <a href="/admin/questions">
            <span>📝</span>
            Questions
          </a>

          <a href="/admin/categories">
            <span>📚</span>
            Categories
          </a>

          <a href="/admin/users">
            <span>👥</span>
            Users
          </a>

          <a href="/admin/attempts">
            <span>🎯</span>
            Quiz Attempts
          </a>

          <a href="/admin/analytics">
            <span>📈</span>
            Analytics
          </a>

          <a href="/admin/achievements">
            <span>🏆</span>
            Achievements
          </a>

          <a href="/admin/notifications">
            <span>🔔</span>
            Notifications
          </a>

          <a href="/admin/reports">
            <span>📑</span>
            Reports
          </a>

          <a href="/admin/activity-logs" class="active">
            <span>📜</span>
            Activity Logs
          </a>

          <a href="/dashboard">
            <span>🏠</span>
            User Dashboard
          </a>
        </nav>

        <div class="admin-sidebar-user">
          <div class="admin-user-avatar">
            <%= user?.firstName
              ? user.firstName.charAt(0).toUpperCase()
              : "A" %>
          </div>

          <div>
            <strong>
              <%= user?.firstName || "Admin" %>
              <%= user?.lastName || "" %>
            </strong>

            <small>Administrator</small>
          </div>
        </div>
      </aside>

      <main class="activity-main">
        <header class="activity-header">
          <div>
            <p class="page-label">Audit Trail</p>

            <h1>Administrator Activity Logs</h1>

            <p>
              Review administrator actions, exports, notifications and system
              activity across QuizMaster Pro.
            </p>
          </div>

          <button
            id="refreshActivityLogsButton"
            type="button"
            class="primary-button"
          >
            Refresh Logs
          </button>
        </header>

        <section class="summary-grid" aria-label="Activity log summary">
          <article class="summary-card">
            <span class="summary-icon">📜</span>

            <div>
              <p>Total Logs</p>
              <strong id="totalLogsCount">0</strong>
            </div>
          </article>

          <article class="summary-card">
            <span class="summary-icon">📅</span>

            <div>
              <p>Today's Logs</p>
              <strong id="todayLogsCount">0</strong>
            </div>
          </article>

          <article class="summary-card">
            <span class="summary-icon">📤</span>

            <div>
              <p>Report Exports</p>
              <strong id="exportLogsCount">0</strong>
            </div>
          </article>

          <article class="summary-card">
            <span class="summary-icon">⚙️</span>

            <div>
              <p>System Events</p>
              <strong id="systemLogsCount">0</strong>
            </div>
          </article>
        </section>

        <section class="activity-controls">
          <div class="search-group">
            <label for="activitySearchInput" class="visually-hidden">
              Search activity logs
            </label>

            <input
              id="activitySearchInput"
              type="search"
              placeholder="Search description, entity ID or IP address..."
              autocomplete="off"
            />
          </div>

          <div class="filter-group">
            <label for="activityActionFilter" class="visually-hidden">
              Filter by action
            </label>

            <select id="activityActionFilter">
              <option value="ALL">All Actions</option>
              <option value="CREATE">Create</option>
              <option value="UPDATE">Update</option>
              <option value="DELETE">Delete</option>
              <option value="SEND">Send</option>
              <option value="EXPORT">Export</option>
              <option value="ENABLE">Enable</option>
              <option value="DISABLE">Disable</option>
              <option value="PROMOTE">Promote</option>
              <option value="DEMOTE">Demote</option>
              <option value="LOGIN">Login</option>
              <option value="LOGOUT">Logout</option>
              <option value="VIEW">View</option>
              <option value="SYSTEM">System</option>
            </select>
          </div>

          <div class="filter-group">
            <label for="activityEntityFilter" class="visually-hidden">
              Filter by entity
            </label>

            <select id="activityEntityFilter">
              <option value="all">All Entities</option>
              <option value="User">User</option>
              <option value="Question">Question</option>
              <option value="Category">Category</option>
              <option value="Attempt">Attempt</option>
              <option value="Achievement">Achievement</option>
              <option value="Notification">Notification</option>
              <option value="Report">Report</option>
              <option value="Analytics">Analytics</option>
              <option value="System">System</option>
            </select>
          </div>
        </section>

        <section id="activityLoadingState" class="state-card">
          <div class="spinner"></div>

          <p>Loading administrator activity...</p>
        </section>

        <section id="activityErrorState" class="state-card hidden">
          <span class="state-icon">⚠️</span>

          <h2>Unable to load activity logs</h2>

          <p id="activityErrorMessage">
            Something went wrong while loading activity logs.
          </p>

          <button
            id="retryActivityLogsButton"
            type="button"
            class="primary-button"
          >
            Try Again
          </button>
        </section>

        <section id="activityContent" class="activity-content hidden">
          <div class="table-wrapper">
            <table class="activity-table">
              <thead>
                <tr>
                  <th>Administrator</th>
                  <th>Action</th>
                  <th>Entity</th>
                  <th>Description</th>
                  <th>IP Address</th>
                  <th>Date</th>
                  <th>Details</th>
                </tr>
              </thead>

              <tbody id="activityLogsTableBody"></tbody>
            </table>
          </div>

          <div id="activityEmptyState" class="state-card hidden">
            <span class="state-icon">📭</span>

            <h2>No activity logs found</h2>

            <p>No administrator activity matches the selected filters.</p>
          </div>

          <nav
            id="activityPagination"
            class="pagination hidden"
            aria-label="Activity log pagination"
          >
            <button
              id="previousActivityPage"
              type="button"
              class="secondary-button"
            >
              Previous
            </button>

            <span id="activityPaginationText">Page 1 of 1</span>

            <button
              id="nextActivityPage"
              type="button"
              class="secondary-button"
            >
              Next
            </button>
          </nav>
        </section>
      </main>
    </div>

    <div id="activityDetailsModal" class="modal hidden" aria-hidden="true">
      <div class="modal-backdrop" data-close-activity-modal></div>

      <section
        class="modal-panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="activityDetailsTitle"
      >
        <header class="modal-header">
          <div>
            <p class="page-label">Audit Information</p>

            <h2 id="activityDetailsTitle">Activity Details</h2>
          </div>

          <button
            type="button"
            class="modal-close-button"
            data-close-activity-modal
            aria-label="Close activity details"
          >
            ×
          </button>
        </header>

        <div class="details-grid">
          <div class="detail-item">
            <span>Administrator</span>
            <strong id="detailsAdministrator">Unknown</strong>
          </div>

          <div class="detail-item">
            <span>Email</span>
            <strong id="detailsAdministratorEmail">Unknown</strong>
          </div>

          <div class="detail-item">
            <span>Action</span>
            <strong id="detailsAction">Unknown</strong>
          </div>

          <div class="detail-item">
            <span>Entity Type</span>
            <strong id="detailsEntityType">Unknown</strong>
          </div>

          <div class="detail-item">
            <span>Entity ID</span>
            <strong id="detailsEntityId">Not available</strong>
          </div>

          <div class="detail-item">
            <span>IP Address</span>
            <strong id="detailsIpAddress">Not available</strong>
          </div>

          <div class="detail-item detail-item-full">
            <span>Description</span>
            <strong id="detailsDescription">Not available</strong>
          </div>

          <div class="detail-item detail-item-full">
            <span>Timestamp</span>
            <strong id="detailsCreatedAt">Not available</strong>
          </div>

          <div class="detail-item detail-item-full">
            <span>User Agent</span>
            <strong id="detailsUserAgent">Not available</strong>
          </div>

          <div class="detail-item detail-item-full">
            <span>Metadata</span>

            <pre id="detailsMetadata">{}</pre>
          </div>  
        </div>

        <footer class="modal-actions">
          <button
            type="button"
            class="secondary-button"
            data-close-activity-modal
          >
            Close
          </button>
        </footer>
      </section>
    </div>
  </body>
</html>
