<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="stylesheet" href="/css/foundation.css" />
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content="Reset your QuizMaster Pro password." />

    <title>Forgot Password | QuizMaster Pro</title>

    <link rel="stylesheet" href="/css/password-reset.css" />

    <script src="/js/forgot-password.js" defer></script>
  </head>

  <body>
    <main class="password-reset-page">
      <section class="password-reset-card">
        <a href="/login" class="brand">
          <span class="brand-icon">Q</span>
          <span>QuizMaster Pro</span>
        </a>

        <div class="reset-icon" aria-hidden="true">🔐</div>

        <p class="section-label">Account recovery</p>

        <h1>Forgot Your Password?</h1>

        <p class="page-description">
          Enter your registered email address. A password-reset link will be
          generated for your account.
        </p>

        <form id="forgotPasswordForm">
          <div class="form-group">
            <label for="forgotPasswordEmail"> Email Address </label>

            <input
              id="forgotPasswordEmail"
              name="email"
              type="email"
              placeholder="Enter your email address"
              autocomplete="email"
              required
            />
          </div>

          <p
            id="forgotPasswordMessage"
            class="form-message"
            aria-live="polite"
          ></p>

          <button
            id="forgotPasswordButton"
            type="submit"
            class="primary-button"
          >
            Generate Reset Link
          </button>
        </form>

        <div id="developmentResetSection" class="development-reset hidden">
          <p>Development reset link</p>

          <a id="developmentResetLink" href="#"> Open password reset page </a>

          <small> This link is shown only during local development. </small>
        </div>

        <a href="/login" class="back-link"> ← Back to login </a>
      </section>
    </main>
  </body>
</html>
