<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="View your QuizMaster Pro profile, level, ranking, achievements and quiz performance."
    />

    <title>Profile | QuizMaster Pro</title>

    <link rel="stylesheet" href="/css/profile.css" />

    <script src="/js/dialogs.js" defer></script>
    <script src="/js/profile.js" defer></script>
  </head>

  <body>
    <main class="profile-page">
      <header class="profile-header">
        <div>
          <p class="profile-label">QuizMaster Pro</p>

          <h1>My Profile</h1>

          <p class="profile-subtitle">
            Track your level, ranking, achievements, quiz activity and account
            progress.
          </p>
        </div>

        <nav
          class="profile-navigation"
          aria-label="Profile navigation"
        >
          <a href="/dashboard">Dashboard</a>
          <a href="/history">History</a>
          <a href="/achievements">Achievements</a>
          <a href="/leaderboard">Leaderboard</a>
        </nav>
      </header>

      <section
        id="profileLoading"
        class="profile-state-card"
      >
        <div
          class="profile-spinner"
          aria-hidden="true"
        ></div>

        <p>Loading your profile...</p>
      </section>

      <section
        id="profileError"
        class="profile-state-card hidden"
      >
        <span
          class="profile-state-icon"
          aria-hidden="true"
        >
          ⚠️
        </span>

        <h2>Unable to load profile</h2>

        <p id="profileErrorMessage">
          Something went wrong.
        </p>

        <button
          id="profileRetryButton"
          type="button"
          class="primary-button"
        >
          Try Again
        </button>
      </section>

      <div
        id="profileContent"
        class="hidden"
      >
        <!-- ==================================================
             PROFILE HERO
        =================================================== -->

        <section class="profile-hero">
          <div class="profile-hero-glow"></div>

          <div class="profile-identity">
            <div
              id="profileAvatar"
              class="profile-avatar"
              aria-label="Profile avatar"
            >
              <span id="profileInitials">
                <%= `${user?.firstName?.[0] || ""}${user?.lastName?.[0] || ""}` %>
              </span>
            </div>

            <div class="profile-identity-content">
              <div class="profile-name-row">
                <div>
                  <h2 id="profileFullName">
                    <%= user?.firstName || "Player" %>
                    <%= user?.lastName || "" %>
                  </h2>

                  <p id="profileEmail">
                    <%= user?.email || "" %>
                  </p>
                </div>

                <div class="profile-badges">
                  <span
                    id="profileRole"
                    class="profile-role"
                  >
                    <%= user?.role || "user" %>
                  </span>

                  <span
                    id="emailVerifiedBadge"
                    class="verification-badge"
                  >
                    Verification pending
                  </span>
                </div>
              </div>

              <div class="profile-level-heading">
                <span
                  id="profileLevel"
                  class="level-badge"
                >
                  Level 1
                </span>

                <strong id="profileRankTitle">
                  Beginner
                </strong>
              </div>

              <div class="level-progress-wrapper">
                <div class="level-progress-header">
                  <span id="levelXpText">
                    0 XP
                  </span>

                  <span id="levelProgressText">
                    0%
                  </span>
                </div>

                <div
                  id="levelProgressTrack"
                  class="level-progress-track"
                  role="progressbar"
                  aria-label="Level progress"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="0"
                >
                  <div
                    id="levelProgressBar"
                    class="level-progress-bar"
                  ></div>
                </div>

                <p id="nextLevelText">
                  Complete quizzes to earn XP and level up.
                </p>
              </div>
            </div>
          </div>

          <button
            id="editProfileButton"
            class="primary-button profile-edit-button"
            type="button"
          >
            Edit Profile
          </button>
        </section>

        <!-- ==================================================
             RANK AND PROFILE COMPLETION
        =================================================== -->

        <section
          class="profile-overview-grid"
          aria-label="Profile overview"
        >
          <article class="overview-card rank-overview-card">
            <div
              class="overview-icon"
              aria-hidden="true"
            >
              🏆
            </div>

            <div class="overview-content">
              <p class="overview-label">
                Global Rank
              </p>

              <div class="overview-heading-row">
                <h2 id="globalRank">
                  --
                </h2>

                <span
                  id="globalRankBadge"
                  class="overview-badge"
                >
                  Ranking
                </span>
              </div>

              <p id="globalRankText">
                Loading ranking information...
              </p>

              <a
                href="/leaderboard"
                class="overview-link"
              >
                View Leaderboard →
              </a>
            </div>
          </article>

          <article class="overview-card completion-overview-card">
            <div
              class="overview-icon"
              aria-hidden="true"
            >
              📋
            </div>

            <div class="overview-content">
              <p class="overview-label">
                Profile Completion
              </p>

              <div class="overview-heading-row">
                <h2 id="completionPercent">
                  0%
                </h2>

                <span
                  id="completionBadge"
                  class="overview-badge"
                >
                  In Progress
                </span>
              </div>

              <div
                id="completionTrack"
                class="completion-track"
                role="progressbar"
                aria-label="Profile completion"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
              >
                <div
                  id="completionBar"
                  class="completion-fill"
                ></div>
              </div>

              <p id="completionText">
                Loading profile completion...
              </p>

              <small id="completionMissing"></small>
            </div>
          </article>
        </section>


        <section class="weekly-activity-section">
  <div class="section-heading">
    <div>
      <p class="section-label">Weekly Activity</p>
      <h2>Your Last 7 Days</h2>
    </div>
  </div>

  <div class="weekly-summary">
    <div class="weekly-summary-card">
      <span>Current Streak</span>
      <strong id="weeklyCurrentStreak">0</strong>
    </div>

    <div class="weekly-summary-card">
      <span>Longest Streak</span>
      <strong id="weeklyLongestStreak">0</strong>
    </div>

    <div class="weekly-summary-card">
      <span>Weekly XP</span>
      <strong id="weeklyXp">0</strong>
    </div>

    <div class="weekly-summary-card">
      <span>Quizzes</span>
      <strong id="weeklyQuizzes">0</strong>
    </div>
  </div>

  <div id="weeklyCalendar" class="weekly-calendar"></div>
</section>
        <!-- ==================================================
             STATISTICS
        =================================================== -->

        <section class="statistics-section">
          <div class="section-heading">
            <div>
              <p class="section-label">Performance</p>

              <h2>Your Statistics</h2>
            </div>

            <a
              href="/analytics"
              class="section-link"
            >
              View Analytics →
            </a>
          </div>

          <div class="statistics-grid">
            <article class="stat-card">
              <span
                class="stat-icon"
                aria-hidden="true"
              >
                ⚡
              </span>

              <div>
                <span class="stat-label">
                  Total XP
                </span>

                <strong id="totalXp">0</strong>
              </div>
            </article>

            <article class="stat-card">
              <span
                class="stat-icon"
                aria-hidden="true"
              >
                🧠
              </span>

              <div>
                <span class="stat-label">
                  Quizzes Completed
                </span>

                <strong id="quizzesCompleted">0</strong>
              </div>
            </article>

            <article class="stat-card">
              <span
                class="stat-icon"
                aria-hidden="true"
              >
                ✅
              </span>

              <div>
                <span class="stat-label">
                  Correct Answers
                </span>

                <strong id="correctAnswers">0</strong>
              </div>
            </article>

            <article class="stat-card">
              <span
                class="stat-icon"
                aria-hidden="true"
              >
                🔥
              </span>

              <div>
                <span class="stat-label">
                  Current Streak
                </span>

                <strong id="currentStreak">0</strong>
              </div>
            </article>

            <article class="stat-card">
              <span
                class="stat-icon"
                aria-hidden="true"
              >
                🎯
              </span>

              <div>
                <span class="stat-label">
                  Average Accuracy
                </span>

                <strong id="averageAccuracy">0%</strong>
              </div>
            </article>

            <article class="stat-card">
              <span
                class="stat-icon"
                aria-hidden="true"
              >
                💯
              </span>

              <div>
                <span class="stat-label">
                  Perfect Scores
                </span>

                <strong id="perfectScores">0</strong>
              </div>
            </article>

            <article class="stat-card">
              <span
                class="stat-icon"
                aria-hidden="true"
              >
                ⏱️
              </span>

              <div>
                <span class="stat-label">
                  Total Quiz Time
                </span>

                <strong id="totalTime">0m</strong>
              </div>
            </article>

            <article class="stat-card">
              <span
                class="stat-icon"
                aria-hidden="true"
              >
                🏅
              </span>

              <div>
                <span class="stat-label">
                  Achievements
                </span>

                <strong id="achievementCount">0</strong>
              </div>
            </article>
          </div>
        </section>

        <!-- ==================================================
     WEEKLY ACTIVITY
=================================================== -->

<section class="weekly-section">

  <div class="section-heading">
    <div>
      <p class="section-label">
        Activity
      </p>

      <h2>Weekly Activity</h2>
    </div>
  </div>

  <div class="weekly-summary">

    <div class="weekly-stat">
      <strong id="weeklyStreak">
        0
      </strong>

      <span>Current Streak</span>
    </div>

    <div class="weekly-stat">
      <strong id="weeklyQuizCount">
        0
      </strong>

      <span>Quizzes This Week</span>
    </div>

    <div class="weekly-stat">
      <strong id="weeklyXp">
        0
      </strong>

      <span>XP Earned</span>
    </div>

  </div>

  <div
    id="weeklyCalendar"
    class="weekly-calendar"
  >

  </div>

</section>

        <!-- ==================================================
             FAVORITE CATEGORY AND ACCOUNT
        =================================================== -->

        <section class="details-grid">
          <article class="details-card">
            <div class="section-heading">
              <div>
                <p class="section-label">
                  Category
                </p>

                <h2>Favorite Category</h2>
              </div>
            </div>

            <div id="favoriteCategoryContent">
              <div class="content-loading">
                Loading category statistics...
              </div>
            </div>
          </article>

          <article class="details-card">
            <div class="section-heading">
              <div>
                <p class="section-label">
                  Account
                </p>

                <h2>Account Details</h2>
              </div>

              <a
                href="/settings"
                class="section-link"
              >
                Settings →
              </a>
            </div>

            <dl class="account-details">
              <div>
                <dt>Email Status</dt>

                <dd id="emailVerificationStatus">
                  Checking...
                </dd>
              </div>

              <div>
                <dt>Joined</dt>

                <dd id="createdAt">-</dd>
              </div>

              <div>
                <dt>Last Login</dt>

                <dd id="lastLoginAt">-</dd>
              </div>

              <div>
                <dt>Last Quiz</dt>

                <dd id="lastQuizDate">-</dd>
              </div>

              <div>
                <dt>Total XP Earned</dt>

                <dd id="totalXpEarned">0</dd>
              </div>

              <div>
                <dt>Highest Score</dt>

                <dd id="highestScore">0</dd>
              </div>

              <div>
                <dt>Highest Accuracy</dt>

                <dd id="highestAccuracy">0%</dd>
              </div>

              <div>
                <dt>Average Quiz Time</dt>

                <dd id="averageTime">0 sec</dd>
              </div>
            </dl>
          </article>
        </section>
      </div>
    </main>

    <!-- ==================================================
         EDIT PROFILE MODAL
    =================================================== -->

    <div
      id="profileModal"
      class="modal hidden"
      aria-hidden="true"
    >
      <div
        class="modal-backdrop"
        data-close-modal
      ></div>

      <section
        class="modal-content"
        role="dialog"
        aria-modal="true"
        aria-labelledby="editProfileTitle"
      >
        <div class="modal-header">
          <div>
            <p class="section-label">
              Account
            </p>

            <h2 id="editProfileTitle">
              Edit Profile
            </h2>
          </div>

          <button
            type="button"
            class="close-button"
            aria-label="Close profile editor"
            data-close-modal
          >
            ×
          </button>
        </div>

        <form
          id="profileForm"
          novalidate
        >
          <div class="form-row">
            <div class="form-group">
              <label for="firstName">
                First Name
              </label>

              <input
                id="firstName"
                name="firstName"
                type="text"
                minlength="2"
                maxlength="50"
                autocomplete="given-name"
                required
              />
            </div>

            <div class="form-group">
              <label for="lastName">
                Last Name
              </label>

              <input
                id="lastName"
                name="lastName"
                type="text"
                minlength="2"
                maxlength="50"
                autocomplete="family-name"
                required
              />
            </div>
          </div>

          <div class="form-group avatar-upload-group">
  <label>Profile Picture</label>

  <div class="avatar-upload-panel">
    <div
      id="avatarPreview"
      class="avatar-preview"
      aria-label="Selected profile picture preview"
    >
      <span id="avatarPreviewInitials">
        <%= `${user?.firstName?.[0] || ""}${user?.lastName?.[0] || ""}` %>
      </span>
    </div>

    <div class="avatar-upload-content">
      <input
        id="avatarFile"
        name="avatar"
        type="file"
        accept="image/jpeg,image/png,image/webp"
        class="avatar-file-input"
      />

      <label
        for="avatarFile"
        class="avatar-select-button"
      >
        Choose Picture
      </label>

      <p id="avatarFileName" class="avatar-file-name">
        No image selected
      </p>

      <small>
        JPEG, PNG or WebP. Maximum file size: 5 MB.
      </small>
    </div>
  </div>

  <div class="avatar-upload-actions">
    <button
      id="uploadAvatarButton"
      type="button"
      class="primary-button"
      disabled
    >
      Upload Picture
    </button>

    <button
      id="removeAvatarButton"
      type="button"
      class="danger-button"
    >
      Remove Picture
    </button>
  </div>

  <p
    id="avatarUploadMessage"
    class="form-message"
    role="alert"
    aria-live="polite"
  ></p>
</div>

          <p
            id="profileMessage"
            class="form-message"
            role="alert"
            aria-live="polite"
          ></p>

          <div class="form-actions">
            <button
              type="button"
              class="secondary-button"
              data-close-modal
            >
              Cancel
            </button>

            <button
              id="saveProfileButton"
              type="submit"
              class="primary-button"
            >
              Save Changes
            </button>
          </div>
        </form>
      </section>
    </div>
  </body>
</html>
