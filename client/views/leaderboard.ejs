<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      name="description"
      content="View the highest-ranked QuizMaster Pro players."
    />

    <title>Leaderboard | QuizMaster Pro</title>

    <link rel="stylesheet" href="/css/leaderboard.css" />
  </head>

  <body>
    <main class="leaderboard-page"> 
      <!-- ================= HEADER ================= -->

      <header class="leaderboard-header">
        <a href="/dashboard" class="brand">
          <span class="brand-icon" aria-hidden="true">Q</span>
          <span>QuizMaster Pro</span>
        </a>

        <nav class="header-navigation" aria-label="Leaderboard navigation">
          <a href="/dashboard">Dashboard</a>

          <span class="current-user"> <%= user?.firstName || "Player" %> </span>

          <button type="button" id="logoutButton" class="logout-button">
            Logout
          </button>
        </nav>
      </header>

      <!-- ================= HERO ================= -->

      <section class="leaderboard-hero">
        <div>
          <p class="section-label">Global rankings</p>

          <h1>QuizMaster Leaderboard</h1>

          <p>Earn XP by completing quizzes and climb your way to the top.</p>
        </div>

        <div class="hero-trophy" aria-hidden="true">🏆</div>
      </section>

      <!-- ================= LOADING ================= -->

      <section class="loading-state" id="loadingState" aria-live="polite">
        <div class="loader" aria-hidden="true"></div>

        <p>Loading leaderboard...</p>
      </section>

      <!-- ================= ERROR ================= -->

      <section class="error-state hidden" id="errorState" aria-live="assertive">
        <div class="error-icon" aria-hidden="true">!</div>

        <h2>Unable to load leaderboard</h2>

        <p id="errorMessage">Please try again.</p>

        <button type="button" id="retryButton" class="primary-button">
          Try Again
        </button>
      </section>

      <!-- ================= CONTENT ================= -->

      <section class="leaderboard-content hidden" id="leaderboardContent">
        <!-- Top three players -->

        <div class="podium" id="podium" aria-label="Top three players"></div>

        <!-- Full leaderboard -->

        <div class="ranking-card">
          <div class="ranking-header">
            <div>
              <p class="section-label">Top players</p>

              <h2>Current Rankings</h2>
            </div>

            <span id="playerCount"> 0 players </span>
          </div>

          <div class="table-wrapper">
            <table class="leaderboard-table">
              <thead>
                <tr>
                  <th scope="col">Rank</th>
                  <th scope="col">Player</th>
                  <th scope="col">XP</th>
                  <th scope="col">Quizzes</th>
                  <th scope="col">Correct</th>
                  <th scope="col">Streak</th>
                </tr>
              </thead>

              <tbody id="leaderboardBody"></tbody>
            </table>
          </div>

          <div id="emptyState" class="empty-state hidden">
            <span aria-hidden="true">🏆</span>

            <h3>No players found</h3>

            <p>Complete a quiz to become the first ranked player.</p>
          </div>
        </div>
      </section>
    </main>

    <script src="/js/leaderboard.js" defer></script>
  </body>
</html>
