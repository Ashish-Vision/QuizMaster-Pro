<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="QuizMaster Pro user dashboard"
    />

    <title>Dashboard | QuizMaster Pro</title>

    <link
      rel="stylesheet"
      href="/css/dashboard.css"
    />
  </head>

  <body>
    <main class="dashboard">
      <!-- ==================================================
           HEADER
      =================================================== -->

      <header class="header">
        <a
          href="/dashboard"
          class="logo"
        >
          <span aria-hidden="true">
            🧠
          </span>

          <span>
            QuizMaster Pro
          </span>
        </a>

        <div class="user-area">
          <nav
            class="dashboard-navigation"
            aria-label="Dashboard navigation"
          >
            <a
              href="/profile"
              class="header-link"
            >
              👤 Profile
            </a>

            <a
              href="/history"
              class="header-link"
            >
              📜 History
            </a>

            <a
              href="/leaderboard"
              class="header-link"
            >
              🏆 Leaderboard
            </a>

            <a
              href="/achievements"
              class="header-link"
            >
              🥇 Achievements
            </a>

            <a
              href="/analytics"
              class="header-link"
            >
              📊 Analytics
            </a>

            <a
              href="/settings"
              class="header-link"
            >
              ⚙️ Settings
            </a>

            <% if (user?.role === "admin") { %>
              <a
                href="/admin"
                class="header-link"
              >
                🛡️ Admin
              </a>
            <% } %>
          </nav>

          <!-- ==============================================
               NOTIFICATION BELL
          =============================================== -->

          <div class="notification-wrapper">
            <button
              id="notificationButton"
              type="button"
              class="notification-button"
              aria-label="Open notifications"
              aria-haspopup="true"
              aria-expanded="false"
            >
              <span aria-hidden="true">
                🔔
              </span>

              <span
                id="notificationBadge"
                class="notification-badge hidden"
                aria-label="Unread notifications"
              >
                0
              </span>
            </button>

            <section
              id="notificationDropdown"
              class="notification-dropdown hidden"
              aria-label="Recent notifications"
            >
              <div class="notification-dropdown-header">
                <div>
                  <p>
                    Notifications
                  </p>

                  <small id="notificationDropdownCount">
                    0 unread
                  </small>
                </div>

                <button
                  id="markDropdownReadButton"
                  type="button"
                  disabled
                >
                  Mark all read
                </button>
              </div>

              <div
                id="notificationDropdownList"
                class="notification-dropdown-list"
                aria-live="polite"
              >
                <div class="notification-dropdown-state">
                  Loading notifications...
                </div>
              </div>

              <a
                href="/notifications"
                class="notification-dropdown-footer"
              >
                View all notifications →
              </a>
            </section>
          </div>

          <span class="welcome">
            Welcome,

            <strong>
              <%= user?.firstName || "Player" %>
            </strong>
          </span>

          <button
            id="logoutButton"
            type="button"
          >
            Logout
          </button>
        </div>
      </header>

      <!-- ==================================================
           HERO
      =================================================== -->

      <section class="hero">
        <div>
          <h1>
            Welcome Back 👋
          </h1>

          <p>
            Ready to improve your rank today? Pick a category,
            test your knowledge and earn more XP.
          </p>
        </div>
      </section>

      <!-- ==================================================
           DAILY CHALLENGE
      =================================================== -->

      <section
        id="dailyChallengeSection"
        class="daily-challenge-section"
        aria-labelledby="dailyChallengeSectionTitle"
      >
        <div class="section-heading">
          <div>
            <p class="section-label">
              Today&apos;s Special Quiz
            </p>

            <h2 id="dailyChallengeSectionTitle">
              🔥 Daily Challenge
            </h2>
          </div>

          <span
            id="dailyChallengeStatus"
            class="daily-challenge-status"
          >
            Loading...
          </span>
        </div>

        <div class="daily-challenge-card">
          <div
            class="daily-challenge-glow"
            aria-hidden="true"
          ></div>

          <!-- Loading State -->

          <div
            id="dailyChallengeLoading"
            class="daily-challenge-state"
          >
            <div
              class="daily-challenge-spinner"
              aria-hidden="true"
            ></div>

            <p>
              Preparing today&apos;s challenge...
            </p>
          </div>

          <!-- Error State -->

          <div
            id="dailyChallengeError"
            class="daily-challenge-state hidden"
          >
            <span
              class="daily-challenge-state-icon"
              aria-hidden="true"
            >
              ⚠️
            </span>

            <h3>
              Daily challenge unavailable
            </h3>

            <p id="dailyChallengeErrorMessage">
              Unable to load today&apos;s challenge.
            </p>

            <button
              id="dailyChallengeRetryButton"
              type="button"
              class="daily-challenge-secondary-button"
            >
              Try Again
            </button>
          </div>

          <!-- Challenge Content -->

          <div
            id="dailyChallengeContent"
            class="daily-challenge-content hidden"
          >
            <div class="daily-challenge-main">
              <div
                id="dailyChallengeIcon"
                class="daily-challenge-icon"
                aria-hidden="true"
              >
                🔥
              </div>

              <div class="daily-challenge-information">
                <div class="daily-challenge-title-row">
                  <div>
                    <p class="daily-challenge-eyebrow">
                      Daily Challenge
                    </p>

                    <h3 id="dailyChallengeTitle">
                      Today&apos;s Challenge
                    </h3>
                  </div>

                  <span
                    id="dailyChallengeDifficulty"
                    class="daily-challenge-difficulty"
                  >
                    Mixed
                  </span>
                </div>

                <p
                  id="dailyChallengeDescription"
                  class="daily-challenge-description"
                >
                  Complete today&apos;s special quiz to earn bonus XP.
                </p>

                <div class="daily-challenge-category-row">
                  <span class="daily-challenge-category-label">
                    Category
                  </span>

                  <strong id="dailyChallengeCategory">
                    Loading...
                  </strong>
                </div>

                <div class="daily-challenge-meta-grid">
                  <article class="daily-challenge-meta-card">
                    <span
                      class="daily-challenge-meta-icon"
                      aria-hidden="true"
                    >
                      🧠
                    </span>

                    <div>
                      <small>
                        Questions
                      </small>

                      <strong id="dailyChallengeQuestionCount">
                        5 Questions
                      </strong>
                    </div>
                  </article>

                  <article class="daily-challenge-meta-card">
                    <span
                      class="daily-challenge-meta-icon"
                      aria-hidden="true"
                    >
                      ⚡
                    </span>

                    <div>
                      <small>
                        Bonus Reward
                      </small>

                      <strong id="dailyChallengeRewardXp">
                        +100 XP
                      </strong>
                    </div>
                  </article>

                  <article class="daily-challenge-meta-card">
                    <span
                      class="daily-challenge-meta-icon"
                      aria-hidden="true"
                    >
                      🏆
                    </span>

                    <div>
                      <small>
                        Reward Badge
                      </small>

                      <strong id="dailyChallengeRewardBadge">
                        Daily Challenger
                      </strong>
                    </div>
                  </article>

                  <article class="daily-challenge-meta-card">
                    <span
                      class="daily-challenge-meta-icon"
                      aria-hidden="true"
                    >
                      ⏳
                    </span>

                    <div>
                      <small>
                        Time Remaining
                      </small>

                      <strong id="dailyChallengeCountdown">
                        00:00:00
                      </strong>
                    </div>
                  </article>
                </div>

                <button
                  id="dailyChallengeStartButton"
                  type="button"
                  class="daily-challenge-start-button"
                >
                  Start Daily Challenge
                </button>
              </div>
            </div>

            <!-- Completed State -->

            <div
              id="dailyChallengeCompleted"
              class="daily-challenge-completed hidden"
            >
              <div class="daily-challenge-completed-heading">
                <span aria-hidden="true">
                  ✅
                </span>

                <div>
                  <p>
                    Challenge Completed
                  </p>

                  <h3>
                    Excellent work!
                  </h3>
                </div>
              </div>

              <div class="daily-challenge-completed-grid">
                <div>
                  <span>
                    Score
                  </span>

                  <strong id="dailyChallengeCompletedScore">
                    0 / 0
                  </strong>
                </div>

                <div>
                  <span>
                    Accuracy
                  </span>

                  <strong id="dailyChallengeCompletedAccuracy">
                    0%
                  </strong>
                </div>

                <div>
                  <span>
                    Bonus XP
                  </span>

                  <strong id="dailyChallengeCompletedXp">
                    +0 XP
                  </strong>
                </div>
              </div>

              <p>
                You have completed today&apos;s challenge.
                Come back tomorrow for a new one.
              </p>

              <a
                id="dailyChallengeResultLink"
                href="/history"
                class="daily-challenge-result-link hidden"
              >
                View Challenge Result →
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- ==================================================
           SEARCH
      =================================================== -->

      <section class="search-section">
        <label
          for="searchInput"
          class="visually-hidden"
        >
          Search quiz categories
        </label>

        <input
          id="searchInput"
          type="search"
          placeholder="Search category..."
          autocomplete="off"
        />
      </section>

      <!-- ==================================================
           QUICK ACTIONS
      =================================================== -->

      <section
        class="quick-actions-section"
        aria-labelledby="quickActionsTitle"
      >
        <div class="section-heading">
          <div>
            <p class="section-label">
              Navigation
            </p>

            <h2 id="quickActionsTitle">
              Quick Actions
            </h2>
          </div>
        </div>

        <div class="quick-actions-grid">
          <a
            href="#categoriesTitle"
            class="quick-action-card"
          >
            <span
              class="quick-action-icon"
              aria-hidden="true"
            >
              🧠
            </span>

            <div>
              <h3>
                Start Quiz
              </h3>

              <p>
                Select a category and test your knowledge.
              </p>
            </div>

            <span
              class="quick-action-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </a>

          <a
            href="/profile"
            class="quick-action-card"
          >
            <span
              class="quick-action-icon"
              aria-hidden="true"
            >
              👤
            </span>

            <div>
              <h3>
                My Profile
              </h3>

              <p>
                View your profile, performance and account information.
              </p>
            </div>

            <span
              class="quick-action-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </a>

          <a
            href="/history"
            class="quick-action-card"
          >
            <span
              class="quick-action-icon"
              aria-hidden="true"
            >
              📜
            </span>

            <div>
              <h3>
                Quiz History
              </h3>

              <p>
                Review your previous quiz attempts and results.
              </p>
            </div>

            <span
              class="quick-action-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </a>

          <a
            href="/leaderboard"
            class="quick-action-card"
          >
            <span
              class="quick-action-icon"
              aria-hidden="true"
            >
              🏆
            </span>

            <div>
              <h3>
                Leaderboard
              </h3>

              <p>
                Compare your XP and ranking with other players.
              </p>
            </div>

            <span
              class="quick-action-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </a>

          <a
            href="/achievements"
            class="quick-action-card"
          >
            <span
              class="quick-action-icon"
              aria-hidden="true"
            >
              🥇
            </span>

            <div>
              <h3>
                Achievements
              </h3>

              <p>
                View unlocked badges and upcoming achievement goals.
              </p>
            </div>

            <span
              class="quick-action-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </a>

          <a
            href="/analytics"
            class="quick-action-card"
          >
            <span
              class="quick-action-icon"
              aria-hidden="true"
            >
              📊
            </span>

            <div>
              <h3>
                Analytics
              </h3>

              <p>
                Explore your accuracy, strengths and performance trends.
              </p>
            </div>

            <span
              class="quick-action-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </a>

          <a
            href="/notifications"
            class="quick-action-card"
          >
            <span
              class="quick-action-icon"
              aria-hidden="true"
            >
              🔔
            </span>

            <div>
              <h3>
                Notifications
              </h3>

              <p>
                Review quiz rewards, achievements and activity updates.
              </p>
            </div>

            <span
              class="quick-action-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </a>

          <a
            href="/settings"
            class="quick-action-card"
          >
            <span
              class="quick-action-icon"
              aria-hidden="true"
            >
              ⚙️
            </span>

            <div>
              <h3>
                Settings
              </h3>

              <p>
                Manage your profile, password and account preferences.
              </p>
            </div>

            <span
              class="quick-action-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        </div>
      </section>

      <!-- ==================================================
           CATEGORIES
      =================================================== -->

      <section
        class="categories-section"
        aria-labelledby="categoriesTitle"
      >
        <div class="section-heading">
          <div>
            <p class="section-label">
              Test your knowledge
            </p>

            <h2
              id="categoriesTitle"
              class="section-title"
            >
              Quiz Categories
            </h2>
          </div>
        </div>

        <div
          id="categoriesContainer"
          class="category-grid"
          aria-live="polite"
        >
          <div class="category-loading">
            Loading quiz categories...
          </div>
        </div>
      </section>

      <!-- ==================================================
           STATISTICS
      =================================================== -->

      <section
        class="statistics-section"
        aria-labelledby="statisticsTitle"
      >
        <div class="section-heading">
          <div>
            <p class="section-label">
              Performance
            </p>

            <h2
              id="statisticsTitle"
              class="section-title"
            >
              Your Statistics
            </h2>
          </div>
        </div>

        <div class="stats-grid">
          <article class="stat-card">
            <h3>
              Total XP
            </h3>

            <h1>
              <%= user?.totalXp || 0 %>
            </h1>
          </article>

          <article class="stat-card">
            <h3>
              Quizzes Completed
            </h3>

            <h1>
              <%= user?.quizzesCompleted || 0 %>
            </h1>
          </article>

          <article class="stat-card">
            <h3>
              Correct Answers
            </h3>

            <h1>
              <%= user?.correctAnswers || 0 %>
            </h1>
          </article>

          <article class="stat-card">
            <h3>
              Current Streak
            </h3>

            <h1>
              <%= user?.currentStreak || 0 %>
            </h1>
          </article>
        </div>
      </section>

      <!-- ==================================================
           ACHIEVEMENTS SUMMARY
      =================================================== -->

      <section
        class="dashboard-achievements-section"
        aria-labelledby="dashboardAchievementsTitle"
      >
        <div class="section-heading">
          <div>
            <p class="section-label">
              Milestones
            </p>

            <h2 id="dashboardAchievementsTitle">
              🥇 Achievements
            </h2>
          </div>

          <a
            href="/achievements"
            class="view-full-leaderboard-link"
          >
            View All Achievements →
          </a>
        </div>

        <div class="achievement-summary-card">
          <div class="achievement-summary-header">
            <div>
              <p>
                Your achievement progress
              </p>

              <strong id="dashboardAchievementProgress">
                Loading...
              </strong>
            </div>

            <span id="dashboardAchievementPercentage">
              0%
            </span>
          </div>

          <div
            id="dashboardAchievementTrack"
            class="dashboard-achievement-track"
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
          >
            <div
              id="dashboardAchievementFill"
              class="dashboard-achievement-fill"
            ></div>
          </div>

          <div
            id="dashboardAchievementsList"
            class="dashboard-achievements-list"
            aria-live="polite"
          >
            <div class="dashboard-achievement-loading">
              Loading achievements...
            </div>
          </div>
        </div>
      </section>

      <!-- ==================================================
           LEADERBOARD
      =================================================== -->

      <section
        class="leaderboard-section"
        aria-labelledby="leaderboardTitle"
      >
        <div class="section-heading">
          <div>
            <p class="section-label">
              Global Rankings
            </p>

            <h2 id="leaderboardTitle">
              🏆 Leaderboard
            </h2>
          </div>

          <div class="leaderboard-heading-actions">
            <span
              id="leaderboardPlayerCount"
              class="leaderboard-player-count"
            >
              0 players
            </span>

            <a
              href="/leaderboard"
              class="view-full-leaderboard-link"
            >
              View Full Leaderboard →
            </a>
          </div>
        </div>

        <div class="leaderboard-card">
          <div
            class="leaderboard-table-header"
            aria-hidden="true"
          >
            <span>
              Rank
            </span>

            <span>
              Player
            </span>

            <span>
              Quizzes
            </span>

            <span>
              XP
            </span>
          </div>

          <div
            id="leaderboardList"
            aria-live="polite"
          >
            <div class="leaderboard-loading">
              Loading leaderboard...
            </div>
          </div>
        </div>

        <div
          id="currentUserRank"
          class="current-user-rank"
          hidden
        ></div>
      </section>
    </main>

    <script
      src="/js/dashboard.js"
      defer
    ></script>

    <script
      src="/js/daily-challenge.js"
      defer
    ></script>

    <script
      src="/js/dashboard-notifications.js"
      defer
    ></script>
  </body>
</html>
