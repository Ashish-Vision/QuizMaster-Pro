<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard | QuizMaster Pro</title>

    <link rel="stylesheet" href="/css/dashboard.css" />
  </head>
  <body>
    <div class="dashboard">
      <!-- ================= HEADER ================= -->

      <header class="header">
        <div class="logo">🧠 QuizMaster Pro</div>

        <div class="user-area">
          <span class="welcome">
            Welcome,
            <strong><%= user.firstName %></strong>
          </span>

          <button id="logoutButton">Logout</button>
        </div>
      </header>

      <!-- ================= HERO ================= -->

      <section class="hero">
        <div>
          <h1>Welcome Back 👋</h1>

          <p>
            Ready to improve your rank today? Pick a category and start solving
            quizzes.
          </p>
        </div>
      </section>

      <!-- ================= SEARCH ================= -->

      <section class="search-section">
        <input id="searchInput" type="text" placeholder="Search category..." />
      </section>

      <!-- ================= CATEGORIES ================= -->

      <section>
        <h2 class="section-title">Quiz Categories</h2>

        <div id="categoriesContainer" class="category-grid">
          <!-- Loaded from API -->
        </div>
      </section>

      <!-- ================= STATS ================= -->

      <section>
        <h2 class="section-title">Your Statistics</h2>

        <div class="stats-grid">
          <div class="stat-card">
            <h3>Total XP</h3>

            <h1><%= user.totalXp || 0 %></h1>
          </div>

          <div class="stat-card">
            <h3>Completed</h3>

            <h1><%= user.quizzesCompleted || 0 %></h1>
          </div>

          <div class="stat-card">
            <h3>Correct</h3>

            <h1><%= user.correctAnswers || 0 %></h1>
          </div>

          <div class="stat-card">
            <h3>Streak</h3>

            <h1><%= user.currentStreak || 0 %></h1>
          </div>
        </div>
      </section>
    </div>

    <script src="/js/dashboard.js"></script>
  </body>
</html>
